# Environment: development | production
APP_ENV=development

# Application JWT
JWT_SECRET_KEY=CHANGE_ME
JWT_EXPIRE_MINUTES=3

# Attendance rules
ATTENDANCE_RADIUS_METERS=30
STUDENT_SESSION_MINUTES=1
QR_TOKEN_LIFETIME_SECONDS=10

# Shared-browser (proxy) detection. Optional: BROWSER_ID_PEPPER falls back to
# JWT_SECRET_KEY, and the two windows only tune how strong a suspicion reads.
# Detection never blocks a student — it records a remark for the CR to review.
# BROWSER_ID_PEPPER=CHANGE_ME
# PROXY_SHORT_WINDOW_SECONDS=20
# PROXY_FRESH_SIGNIN_SECONDS=900
# Render/proxy hop count used when picking the trusted X-Forwarded-For entry.
# TRUSTED_PROXY_COUNT=1

# Frontend (CORS). Comma-separate multiple origins in production.
FRONTEND_URL=http://localhost:5173

# Public base URL used inside QR codes
PUBLIC_APP_URL=http://localhost:5173

# Firebase Admin (path to service-account JSON)
FIREBASE_CREDENTIALS_FILE=./firebasecreds.json

# Google Sheets (can reuse the same service-account file)
GOOGLE_SERVICE_ACCOUNT_FILE=./firebasecreds.json
GOOGLE_SHEET_ID=CHANGE_ME
GOOGLE_SHEET_NAME=Attendance
GOOGLE_STUDENTS_SHEET_NAME=Sheet1
